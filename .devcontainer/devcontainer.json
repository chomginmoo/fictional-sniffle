{
  "name": "private-browser",
  "image": "mcr.microsoft.com/playwright:v1.47.0-jammy",
  "features": {},
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "render-server",
      "visibility": "private",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "cd apps/server && npm install && npx playwright install chromium",
  "postStartCommand": "bash .devcontainer/autostart.sh",
  "customizations": {
    "vscode": {
      "extensions": []
    }
  }
}
